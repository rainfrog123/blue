{
  "manifest_version": 3,
  "name": "Stake Baccarat",
  "version": "8.1.17",
  "description": "PP multibaccarat HUD in the Multiplay iframe + trusted clicks via Chrome debugger.",
  "permissions": ["debugger", "storage"],
  "host_permissions": [
    "*://client.pragmaticplaylive.net/*",
    "*://*.stake.com/*",
    "*://stake.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Stake Baccarat 8.1.17",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://client.pragmaticplaylive.net/*",
        "*://*.stake.com/*",
        "*://stake.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "*://client.pragmaticplaylive.net/*",
        "*://*.stake.com/*",
        "*://stake.com/*"
      ],
      "js": ["page.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
