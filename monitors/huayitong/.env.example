# Huayitong API auth — capture from the iOS/Android app (Charles / mitmproxy)
HUAYITONG_TOKEN=
HUAYITONG_ACCESS_TOKEN=
HUAYITONG_COOKIE=

# Optional: this PC hits Aliyun WAF direct; guest mitmweb TLS is allowed (2026-08-15).
# HUAYITONG_PROXY=http://192.168.23.128:8080
# HUAYITONG_PROXY_INSECURE=1

# Notifiers: telegram | serverchan | wecom (comma list)
# WeCom = group webhook only (no Path A message/send dual-ping)
HUAYITONG_NOTIFIERS=wecom

# Telegram (optional — comment out tokens if unused)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ServerChan WeChat push — https://sct.ftqq.com/
SERVERCHAN_URL=

# WeCom: GQ hook = 放号 (WECOM_WEBHOOK_URL). CJC hook = personal (WECOM_TEST_URL).
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_GQ_KEY
# WECOM_TEST_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_CJC_KEY
# WECOM_MAX_SLOTS=3

# Doctors: config/doctors.json (slug, doctorId, docCode, hook, active). Not this file.
# HUAYITONG_PEAK_INTERVAL=3
# HUAYITONG_INTERVAL_MIN=9
# HUAYITONG_INTERVAL_MAX=13
# HUAYITONG_ERROR_WAIT_MIN=30
# HUAYITONG_ERROR_WAIT_MAX=60
# HUAYITONG_NOTIFY_COOLDOWN=0
