// ==UserScript==
// @name         Gemini Input (Fixed Height + Autofocus)
// @namespace    http://tampermonkey.net/
// @version      2.0.1
// @description  Fixed chat input height + type-anywhere / Ctrl+V focuses the prompt
// @author       You
// @match        https://gemini.google.com/*
// @grant        GM_addStyle
// @run-at       document-idle
// ==/UserScript==

/*
 * Merged from (see archive/*.bak):
 *   - archive/fixed-input-height.js.bak
 *       Fix Chat Input Auto-Resize — CSS locks input-area-v2 / .textarea-wrapper
 *       / rich-textarea / .ql-editor to a fixed height; also centers top-bar title.
 *   - archive/auto-focus.js.bak
 *       Auto Focus — typing (or Ctrl/Cmd+V) anywhere focuses the Gemini prompt
 *       (.ql-editor / "Enter a prompt for Gemini" / "Ask Gemini").
 *
 * Functions in this file:
 *   getPromptInput / isInInput / focusAtEnd (+ GM_addStyle height rules)
 */

(function () {
  "use strict";

  const LOG = "[Gemini Input Fixed Height + Autofocus]";
  const fixedHeight = "33px";

  // --- Inherited: archive/fixed-input-height.js.bak ---
  GM_addStyle(`
        input-area-v2 .text-input-field,
        input-area-v2 .text-input-field.simplified-input-area {
            height: ${fixedHeight} !important;
            min-height: ${fixedHeight} !important;
            max-height: ${fixedHeight} !important;
        }

        input-area-v2 .textarea-wrapper,
        input-area-v2 [data-test-id="textarea-wrapper"],
        .text-input-field_textarea-wrapper {
            height: ${fixedHeight} !important;
            min-height: ${fixedHeight} !important;
            max-height: ${fixedHeight} !important;
        }

        input-area-v2 .text-input-field_textarea-inner,
        input-area-v2 [data-test-id="textarea-inner"] {
            height: 100% !important;
            min-height: 100% !important;
            max-height: 100% !important;
        }

        input-area-v2 rich-textarea.text-input-field_textarea,
        input-area-v2 rich-textarea {
            height: 100% !important;
            min-height: 100% !important;
            max-height: 100% !important;
            --chat-container-height: ${fixedHeight} !important;
        }

        input-area-v2 .ql-editor.textarea,
        input-area-v2 .ql-editor.new-input-ui {
            height: 100% !important;
            min-height: 100% !important;
            max-height: 100% !important;
            overflow-y: auto !important;
        }

        input-area-v2 .text-input-field-main-area,
        input-area-v2 .single-line-format {
            height: 100% !important;
            min-height: 100% !important;
            max-height: 100% !important;
        }

        .top-bar-actions {
            display: flex !important;
            justify-content: space-between !important;
            align-items: center !important;
        }

        .top-bar-actions .left-section,
        .top-bar-actions .right-section {
            flex: 1 1 0 !important;
            min-width: 0 !important;
        }

        .top-bar-actions .right-section {
            display: flex !important;
            justify-content: flex-end !important;
        }

        .top-bar-actions .center-section {
            flex: 0 1 auto !important;
            text-align: center !important;
        }
    `);

  // --- Inherited: archive/auto-focus.js.bak ---
  function getPromptInput() {
    return (
      document.querySelector('[aria-label="Enter a prompt for Gemini"]') ||
      document.querySelector('[data-placeholder="Ask Gemini"]') ||
      document.querySelector("input-area-v2 .ql-editor.textarea") ||
      document.querySelector("input-area-v2 .ql-editor") ||
      document.querySelector('.ql-editor[contenteditable="true"]')
    );
  }

  function isInInput() {
    const el = document.activeElement;
    if (!el) return false;
    const tag = el.tagName.toLowerCase();
    return tag === "input" || tag === "textarea" || el.isContentEditable;
  }

  function focusAtEnd(el) {
    el.focus();
    if (el.isContentEditable) {
      const sel = window.getSelection();
      const range = document.createRange();
      range.selectNodeContents(el);
      range.collapse(false);
      sel.removeAllRanges();
      sel.addRange(range);
    } else if (el.setSelectionRange) {
      const len = el.value.length;
      el.setSelectionRange(len, len);
    }
  }

  document.addEventListener("keydown", (e) => {
    if (isInInput()) return;

    const input = getPromptInput();
    if (!input) return;

    if ((e.ctrlKey || e.metaKey) && e.key === "v") {
      focusAtEnd(input);
      return;
    }

    if (e.ctrlKey || e.metaKey || e.altKey) return;
    if (e.key.length !== 1) return;

    focusAtEnd(input);
  });

  console.log(LOG, "loaded — fixed height + type-anywhere focus");
})();
