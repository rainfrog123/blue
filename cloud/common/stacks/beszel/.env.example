# Hub public URL (CF Tunnel hostname recommended)
APP_URL=https://beszel.hyas.site

# Host bind for Hub port (loopback + CF tunnel is safest)
BESZEL_BIND=127.0.0.1:8090

# Local agent dials Hub on the host (after publish)
LOCAL_HUB_URL=http://127.0.0.1:8090

# Filled by setup-hub.sh after first bootstrap (also copied to fleet agent site.env)
TOKEN=
KEY=

# Optional: seed admin on first setup-hub.sh run
ADMIN_EMAIL=admin@blue.local
ADMIN_PASS=
