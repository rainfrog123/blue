# Optional overrides (hardcoded ServerChan fallback lives in config/settings.py)

# HXKQ_DEPARTMENT_ID=7301
# HXKQ_DEPARTMENT_NAME=牙周病科（华西院区）
# HXKQ_CHECK_INTERVAL=20
# HXKQ_LOOKAHEAD_DAYS=7

# Notifiers: telegram | serverchan | wecom (comma list)
# WeCom = group webhook only (no Path A message/send dual-ping)
HXKQ_NOTIFIERS=wecom
# HXKQ_NOTIFIERS=telegram,wecom

# Telegram (optional — comment out tokens if unused)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ServerChan — overrides hardcoded default when set
# SERVERCHAN_URL=https://sctapi.ftqq.com/YOUR_KEY.send

# WeCom group webhook (企微群 — see WeCom Push Setup Path B)
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY
# WECOM_MAX_SLOTS=3
