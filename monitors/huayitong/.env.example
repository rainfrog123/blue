# Huayitong API auth — capture from the iOS/Android app (Charles / mitmproxy)
HUAYITONG_TOKEN=
HUAYITONG_ACCESS_TOKEN=
HUAYITONG_COOKIE=

# Optional: this PC hits Aliyun WAF direct; guest mitmweb TLS is allowed (2026-08-15).
# HUAYITONG_PROXY=http://192.168.23.128:8080
# HUAYITONG_PROXY_INSECURE=1

# Notifiers: telegram | serverchan | wecom (comma list)
# WeCom = group webhook only (no Path A message/send dual-ping)
HUAYITONG_NOTIFIERS=wecom,telegram

# Telegram (optional — comment out tokens if unused)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ServerChan WeChat push — https://sct.ftqq.com/
SERVERCHAN_URL=

# WeCom group webhook (企微群 — see WeCom Push Setup Path B)
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY
# WECOM_MAX_SLOTS=3

# Timing (seconds)
# HUAYITONG_PEAK_INTERVAL=5
# HUAYITONG_INTERVAL_MIN=15
# HUAYITONG_INTERVAL_MAX=25
# HUAYITONG_NOTIFY_COOLDOWN=60
