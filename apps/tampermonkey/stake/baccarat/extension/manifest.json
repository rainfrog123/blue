{
  "manifest_version": 3,
  "name": "Stake Baccarat",
  "version": "8.2.2",
  "description": "PP multibaccarat HUD in the Multiplay iframe + trusted clicks via Chrome debugger.",
  "permissions": ["debugger", "storage"],
  "host_permissions": [
    "*://client.pragmaticplaylive.net/*",
    "*://*.stake.com/*",
    "*://stake.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Stake Baccarat 8.2.2",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://client.pragmaticplaylive.net/*",
        "*://*.stake.com/*",
        "*://stake.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "*://client.pragmaticplaylive.net/*",
        "*://*.stake.com/*",
        "*://stake.com/*"
      ],
      "js": [
        "src/ns.js",
        "src/focus.js",
        "src/bridge.js",
        "src/util.js",
        "src/pp.js",
        "src/pick.js",
        "src/play.js",
        "src/boot.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
