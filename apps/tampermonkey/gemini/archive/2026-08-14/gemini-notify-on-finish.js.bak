// ==UserScript==
// @name         Gemini Notify on Finish
// @namespace    http://tampermonkey.net/
// @version      1.2.0
// @description  In-page toast when a Gemini response finishes (auto-hides)
// @author       You
// @match        https://gemini.google.com/*
// @grant        none
// @run-at       document-idle
// ==/UserScript==

/*
 * Same finish signals as gemini-copy-response-auto-and-ctrl-c.js
 * (.response-footer.complete + aria-busy + stable text).
 *
 * In-page toast only. Fades out on its own — no close button.
 */

(function () {
  "use strict";

  const LOG = "[Gemini Notify]";
  const SETTLE_MS = 900;
  const POLL_MS = 800;
  const STABLE_MS = 700;
  const TOAST_MS = 2000;
  const TOAST_FADE_MS = 340;
  const TOAST_ID = "jefr-gemini-finish-toast";
  const TOAST_CSS_ID = TOAST_ID + "-css";

  /** @type {Set<string>} */
  const seenIds = new Set();
  /** @type {Map<string, {len:number, since:number}>} */
  const stableMap = new Map();
  let pending = null;
  let booted = false;

  function debug(...args) {
    console.log(LOG, ...args);
  }

  function getContentEl(modelResponse) {
    return (
      modelResponse?.querySelector?.(
        '[id^="model-response-message-content"]'
      ) || null
    );
  }

  function extractResponseText(modelResponse) {
    const content = getContentEl(modelResponse);
    if (!content) return "";
    return (content.innerText || content.textContent || "")
      .replace(/\u00a0/g, " ")
      .trim();
  }

  function findCopyInResponse(modelResponse) {
    return (
      modelResponse.querySelector(
        'gem-icon-button[gemtooltip="Copy response"] button[aria-label="Copy"]'
      ) ||
      modelResponse.querySelector("copy-button button[aria-label='Copy']") ||
      modelResponse.querySelector("copy-button button") ||
      null
    );
  }

  function getLatestModelResponse() {
    const responses = document.querySelectorAll("model-response");
    if (!responses.length) return null;
    return responses[responses.length - 1];
  }

  function responseId(modelResponse) {
    const content = getContentEl(modelResponse);
    if (content?.id) return content.id;
    const conv = modelResponse.closest(".conversation-container");
    if (conv?.id) return `conv:${conv.id}`;
    return null;
  }

  function isComplete(modelResponse) {
    const content = getContentEl(modelResponse);
    if (!content) return false;
    if (content.getAttribute("aria-busy") === "true") return false;

    const footer = modelResponse.querySelector(".response-footer");
    if (footer && !footer.classList.contains("complete")) return false;
    if (footer?.classList.contains("complete")) return true;

    return (
      content.getAttribute("aria-busy") === "false" &&
      !!findCopyInResponse(modelResponse)
    );
  }

  function textIsStable(id, text) {
    const now = Date.now();
    const prev = stableMap.get(id);
    if (!prev || prev.len !== text.length) {
      stableMap.set(id, { len: text.length, since: now });
      return false;
    }
    return now - prev.since >= STABLE_MS && text.length > 0;
  }

  function notify() {
    showToast();
    debug("toast shown");
  }

  function ensureToastCss() {
    if (document.getElementById(TOAST_CSS_ID)) return;
    const s = document.createElement("style");
    s.id = TOAST_CSS_ID;
    s.textContent = `
      #${TOAST_ID}{
        position:fixed;top:20px;left:50%;z-index:2147483646;pointer-events:none;
        display:flex;align-items:center;gap:8px;
        padding:7px 14px 7px 11px;border-radius:999px;
        font:500 12px/1 system-ui,"Segoe UI",sans-serif;letter-spacing:.06em;
        color:rgba(255,255,255,.9);
        background:rgba(28,28,30,.62);
        border:1px solid rgba(255,255,255,.1);
        box-shadow:0 10px 36px rgba(0,0,0,.16);
        backdrop-filter:blur(18px) saturate(1.25);
        -webkit-backdrop-filter:blur(18px) saturate(1.25);
        transform:translate(-50%,-10px);opacity:0;
        transition:opacity ${TOAST_FADE_MS}ms cubic-bezier(.22,1,.36,1),
                   transform ${TOAST_FADE_MS}ms cubic-bezier(.22,1,.36,1);
      }
      #${TOAST_ID}.on{opacity:1;transform:translate(-50%,0)}
      #${TOAST_ID} i{
        width:6px;height:6px;border-radius:50%;flex:none;
        background:#8ee0b0;box-shadow:0 0 0 3px rgba(142,224,176,.16);
      }
    `;
    document.documentElement.appendChild(s);
  }

  function showToast() {
    ensureToastCss();
    document.getElementById(TOAST_ID)?.remove();

    const el = document.createElement("div");
    el.id = TOAST_ID;
    el.setAttribute("role", "status");
    el.innerHTML = "<i></i><span>Done</span>";
    document.documentElement.appendChild(el);
    requestAnimationFrame(() => {
      requestAnimationFrame(() => el.classList.add("on"));
    });

    setTimeout(() => {
      el.classList.remove("on");
      setTimeout(() => el.remove(), TOAST_FADE_MS);
    }, TOAST_MS);
  }

  function seedExisting() {
    let n = 0;
    document.querySelectorAll("model-response").forEach((mr) => {
      const id = responseId(mr);
      if (!id || seenIds.has(id)) return;
      if (isComplete(mr) && extractResponseText(mr)) {
        seenIds.add(id);
        n++;
      }
    });
    debug(`seeded ${n} finished response(s)`);
  }

  function tryNotifyLatest() {
    const latest = getLatestModelResponse();
    if (!latest) return;

    const id = responseId(latest);
    if (!id || seenIds.has(id)) return;
    if (!isComplete(latest)) return;

    const text = extractResponseText(latest);
    if (!textIsStable(id, text)) {
      scheduleScan();
      return;
    }

    seenIds.add(id);
    notify();
  }

  function scheduleScan() {
    if (pending) clearTimeout(pending);
    pending = setTimeout(() => {
      pending = null;
      tryNotifyLatest();
    }, SETTLE_MS);
  }

  const obs = new MutationObserver(() => scheduleScan());

  function start() {
    if (booted) return;
    booted = true;
    seedExisting();
    obs.observe(document.body, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ["aria-busy", "class"],
      characterData: true,
    });
    setInterval(tryNotifyLatest, POLL_MS);
    debug("watching (in-page toast, auto-hide)");
  }

  let lastHref = location.href;
  setInterval(() => {
    if (location.href === lastHref) return;
    lastHref = location.href;
    debug("route change — re-seed finished only");
    seenIds.clear();
    stableMap.clear();
    seedExisting();
  }, 1000);

  if (document.body) start();
  else document.addEventListener("DOMContentLoaded", start, { once: true });
})();
